      "source": [
        "#@title t-SNE Dimensionality Reduction Visualisation\n",
        "from sklearn.manifold import TSNE\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "import copy\n",
        "\n",
        "\n",
        "# FUNCTION: plt_tsne\n",
        "# PURPOSE:  Plots a t-SNE graph for a given dataframe\n",
        "def plot_tsne(df, dataset_name, sample_size):\n",
        "  # reduce sample size\n",
        "  df = df.sample(sample_size, random_state=42)\n",
        "\n",
        "  # get features and labels\n",
        "  X = df.drop('attack_specific', axis=1).values\n",
        "  y = df['attack_specific'].values\n",
        "\n",
        "  tsne = TSNE(n_components=3, perplexity=30, learning_rate=200,\n",
        "              max_iter=1000, random_state=42)\n",
        "  X_embedded = tsne.fit_transform(X)\n",
        "\n",
        "  # plot a graph\n",
        "  plt.figure(figsize=(12,5))\n",
        "\n",
        "  attack_specific = np.unique(y)\n",
        "  attack_labels = [\"Normal\", \"Address Scan\", \"Function Code Scan\", \"Device Identification\",\n",
        "                   \"Naive Sensor Read\", \"Sporadic Sensor Measurement Injection\",\n",
        "                   \"Force Listen Mode\", \"Restart Communication\", \"Data Flood\",\n",
        "                   \"Connection Flood\"]\n",
        "  for attack in attack_specific:\n",
        "    plt.scatter(\n",
        "        X_embedded[y == attack, 0],\n",
        "        X_embedded[y == attack, 1],\n",
        "        label=attack_labels[attack],\n",
        "        alpha=0.5,\n",
        "        s=10\n",
        "    )\n",
        "\n",
        "  plt.legend()\n",
        "  plt.title(f\"t-SNE Visualization of Network Traffic for the {dataset_name} Dataset\")\n",
        "  plt.show()\n",
        "\n",
        "\n",
        "# create a dataset copy for visualisation\n",
        "datasets_visual = copy.deepcopy(ics_datasets)\n",
        "\n",
        "# OPTIONAL: remove the DDOS packets as there are so many of them\n",
        "for dataset_name, df in datasets_visual.items():\n",
        "  #df = df[df['attack_specific'] != 8] # data flood\n",
        "  #df = df[df['attack_specific'] != 9] # connection flood\n",
        "  datasets_visual[dataset_name] = df\n",
        "\n",
        "# call for each dataset\n",
        "for dataset_name, df in datasets_visual.items():\n",
        "  # print attacks present in dataset\n",
        "  attack_specific = np.unique(df['attack_specific'].values)\n",
        "  print(attack_specific)\n",
        "\n",
        "  # construct t-SNE diagram\n",
        "  plot_tsne(df, dataset_name, 5000)"
      ]
    },
