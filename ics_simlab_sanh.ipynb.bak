      "source": [
        "#@title Load Datasets\n",
        "import pandas as pd\n",
        "import os\n",
        "from google.colab import drive, files\n",
        "from IPython.display import display\n",
        "\n",
        "# load datasets\n",
        "df_ied = pd.read_csv('/content/drive/MyDrive/Colab Notebooks/ics-simlab-modbus/dataset_ied_packetv4.csv')\n",
        "df_sg = pd.read_csv('/content/drive/MyDrive/Colab Notebooks/ics-simlab-modbus/dataset_sg_packetv4.csv')\n",
        "df_wbf = pd.read_csv('/content/drive/MyDrive/Colab Notebooks/ics-simlab-modbus/dataset_wbf_packetv4.csv')\n",
        "\n",
        "# place each dataframe into a dataset dictionary\n",
        "ics_datasets_orig = {\n",
        "    \"Intelligent Electronic Device\": df_ied,\n",
        "    \"Smart Grid\": df_sg,\n",
        "    \"Water Bottle Factory\": df_wbf\n",
        "}\n",
        "isClean = False\n",
        "\n",
        "# print info on each dataset\n",
        "for dataset_name, df in ics_datasets_orig.items():\n",
        "  print(\"===================================\")\n",
        "  print(f\"Dataset: {dataset_name}\")\n",
        "  print(f\"Shape: {df.shape}\")\n",
        "  print(f\"Column Names: {df.columns}\")"
      ]
    },
