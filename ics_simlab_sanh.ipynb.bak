      "source": [
        "import torch\n",
        "from torch import nn, optim\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.metrics import classification_report, confusion_matrix, precision_recall_curve, roc_auc_score\n",
        "import numpy as np\n",
        "\n",
        "\n",
        "# CLASS:    AutoEncoder\n",
        "# PURPOSE:  A vanila autoencoder neural network.\n",
        "class AutoEncoder(nn.Module):\n",
        "  def __init__(self, input_dim):\n",
        "    super(AutoEncoder, self).__init__()\n",
        "\n",
        "    # encoder (12 dim latent space)\n",
        "    self.encoder = nn.Sequential(\n",
        "      nn.Linear(input_dim, 128),\n",
        "      nn.ReLU(),\n",
        "      nn.Linear(128, 64),\n",
        "      nn.ReLU(),\n",
        "      nn.Linear(64, 32),\n",
        "      #nn.ReLU(),\n",
        "      #nn.Linear(32, 16),\n",
        "    )\n",
        "\n",
        "    # decoder\n",
        "    self.decoder = nn.Sequential(\n",
        "      #nn.Linear(16, 32),\n",
        "      #nn.ReLU(),\n",
        "      nn.Linear(32, 64),\n",
        "      nn.ReLU(),\n",
        "      nn.Linear(64, 128),\n",
        "      nn.ReLU(),\n",
        "      nn.Linear(128, input_dim)\n",
        "    )\n",
        "\n",
        "  def forward(self, x):\n",
        "    encoded = self.encoder(x)\n",
        "    decoded = self.decoder(encoded)\n",
        "    return decoded\n",
        "\n",
        "\n",
        "\n",
        "# FUNCTION: preprocess_ae\n",
        "# PURPOSE:  A function to further preprocess data specifically for the\n",
        "#           autoencoder. Returns training and test data (no need for prediction\n",
        "#           data in an autoencoder).\n",
        "def preprocess_ae(df):\n",
        "  # convert the multiclass dataset in a single class\n",
        "  if \"is_attack\" not in df.columns:\n",
        "    df[\"is_attack\"] = (df[\"attack_specific\"] != 0).astype(int)\n",
        "\n",
        "    # drop the attack_specfic column once created the binary column\n",
        "    if \"attack_specific\" in df.columns:\n",
        "      df.drop(\"attack_specific\", axis=1, inplace=True)\n",
        "\n",
        "  # train only on normal data\n",
        "  X = df.drop(columns=[\"is_attack\"])\n",
        "  y = df[\"is_attack\"]\n",
        "\n",
        "  X_train = X[y == 0]\n",
        "  X_test = X\n",
        "\n",
        "  return X_train, X_test\n",
        "\n",
        "\n",
        "\n",
        "# FUNCTION: construct_ae\n",
        "# PURPOSE:  Builds an autoencoder model for anomaly classification.\n",
        "def construct_ae(X_train, epochs=30, batch_size=16):\n",
        "  # convert to PyTorch tensors\n",
        "  X_train_t = torch.tensor(X_train.values, dtype=torch.float32)\n",
        "\n",
        "  # initialist the model\n",
        "  input_dim = X_train_t.shape[1]\n",
        "  model = AutoEncoder(input_dim)\n",
        "\n",
        "  # define the loss function and optimizer\n",
        "  criterion = nn.MSELoss()\n",
        "  optimizer = optim.Adam(model.parameters(), lr=0.001)\n",
        "\n",
        "  for epoch in range(epochs):\n",
        "    epoch_loss = 0.0\n",
        "\n",
        "    for i in range(0, X_train_t.size(0), batch_size):\n",
        "      # select batch\n",
        "      batch = X_train_t[i:i+batch_size]\n",
        "\n",
        "      # reset accumulated gradients\n",
        "      optimizer.zero_grad()\n",
        "\n",
        "      # perform forward pass and back propagation\n",
        "      output = model(batch)\n",
        "      loss = criterion(output, batch)\n",
        "      loss.backward()\n",
        "      optimizer.step()\n",
        "\n",
        "      # get the current epoch loss\n",
        "      epoch_loss += loss.item()\n",
        "    print(f\"Epoch {epoch+1}/{epochs}, Loss: {epoch_loss/len(X_train_t):.6f}\")\n",
        "\n",
        "  return model\n",
        "\n",
        "\n",
        "\n",
        "# FUNCTION: detect_anomaly\n",
        "# PURPOSE:  Given an autoencoder, predicts an anomaly. An anomaly is true if\n",
        "#           it's reconstructed error falls outside the given percentile.\n",
        "def detect_anomaly(model, X_train, X_test, y_true, dataset_name, cus_percentile=95, return_originals=False):\n",
        "  # compute reconstruction error (per test sample)\n",
        "  model.eval()\n",
        "  with torch.no_grad():\n",
        "    reconstructed = model(X_test)\n",
        "    reconstructed_mse = torch.mean(torch.pow(X_test - reconstructed, 2), dim=1).numpy()\n",
        "\n",
        "  # choose a reconstruction error for the anomaly threshold (95th percentile)\n",
        "  recon_train = model(X_train)\n",
        "  recon_error_train = torch.mean(torch.pow(X_train - recon_train, 2), dim=1).detach().numpy()\n",
        "  best_threshold = np.percentile(recon_error_train, cus_percentile)\n",
        "  print(\"Threshold:\", best_threshold)\n",
        "\n",
        "  # classify anomalies\n",
        "  anomaly_labels = (reconstructed_mse > best_threshold).astype(int)\n",
        "\n",
        "  # save the threshold\n",
        "  if dataset_name is not None:\n",
        "    file_threshold_name = dataset_name.lower().replace(\" \", \"_\") + \"_threshold.txt\"\n",
        "    with open(file_threshold_name, \"w\") as f:\n",
        "      f.write(str(best_threshold))\n",
        "\n",
        "  # get originals\n",
        "  if return_originals:\n",
        "    # return the original X_test samples flagged as anomalies\n",
        "    original_anomalies = X_test[anomaly_labels == 1]\n",
        "    print(len(original_anomalies))\n",
        "    return anomaly_labels, original_anomalies\n",
        "\n",
        "  return anomaly_labels\n",
        "\n",
        "\n",
        "\n",
        "# FUNCTION: eval_ae\n",
        "# PURPOSE:  Evaluates an autoencoder. Includes a class balancing step for\n",
        "#           fair evaluation.\n",
        "def eval_ae(df, ae_model, dataset_name=None):\n",
        "  # undersample the normal packets for evaluation\n",
        "  df_normal = df[df[\"is_attack\"] == 0]\n",
        "  df_attack = df[df[\"is_attack\"] == 1]\n",
        "  df_normal = df_normal.sample(n=len(df_attack), random_state=42)\n",
        "  df_balanced = pd.concat([df_normal, df_attack])\n",
        "  #df_balanced = df\n",
        "\n",
        "  # use all the normal data to get a reconstuction error percentile\n",
        "  X = df_balanced.drop(columns=[\"is_attack\"])\n",
        "  y = df_balanced[\"is_attack\"]\n",
        "\n",
        "  X_train = X[y == 0]\n",
        "  X_test = X\n",
        "\n",
        "  X_train_t = torch.tensor(X_train.values, dtype=torch.float32)\n",
        "  X_test_t = torch.tensor(X_test.values, dtype=torch.float32)\n",
        "\n",
        "  # get ground truth\n",
        "  y_true = df_balanced[\"is_attack\"]\n",
        "\n",
        "  # predict anomalies\n",
        "  y_pred, anomalies = detect_anomaly(ae_model, X_train_t, X_test_t, y_true, dataset_name, return_originals=True)\n",
        "\n",
        "  # evaluate model\n",
        "  print(\"Confusion Matrix:\\n\", confusion_matrix(y_true, y_pred))\n",
        "  print(\"\\nClassification Report:\\n\", classification_report(y_true, y_pred))\n",
        "\n",
        "  # view original anomalies\n",
        "  print(\"Number of anomlies detected:\", len(anomalies))\n",
        "  print(\"First anomalous sample:\", anomalies[0])\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "build_ae_model = False   # convenient flag to determine if to train the model\n",
        "if build_ae_model:\n",
        "  # run a model for each dataset\n",
        "  ae_models = {}\n",
        "  for dataset_name, df in ics_datasets.items():\n",
        "    print(\"=========================================\")\n",
        "    print(f\"Dataset: {dataset_name}\")\n",
        "\n",
        "    # preprocess to get training and testing data\n",
        "    df_ae_copy = df.copy()\n",
        "    X_train, X_test = preprocess_ae(df_ae_copy)\n",
        "    df_ae_copy = None   # just for safety, have run into side-effects before >:(\n",
        "\n",
        "    # train a model\n",
        "    ae_model = construct_ae(X_train)\n",
        "    ae_models[dataset_name] = ae_model\n",
        "\n",
        "    # save the model\n",
        "    file_model_name = dataset_name.lower().replace(\" \", \"_\") + \"_ae_model.pt\"\n",
        "    torch.save(ae_model.state_dict(), file_model_name)\n",
        "\n",
        "\n",
        "\n",
        "load_ae_models = True    # convenient flag to load a model\n",
        "if load_ae_models:\n",
        "  ae_models = {}\n",
        "  weight_files = {\n",
        "      \"Intelligent Electronic Device\": \"intelligent_electronic_device_ae_model.pt\",\n",
        "      \"Smart Grid\": \"smart_grid_ae_model.pt\",\n",
        "      \"Water Bottle Factory\": \"water_bottle_factory_ae_model.pt\",\n",
        "  }\n",
        "  for dataset_name, weight_file in weight_files.items():\n",
        "    ae_model = AutoEncoder(18)    # 18 is the input dimension\n",
        "    ae_model.load_state_dict(torch.load(weight_file))\n",
        "    ae_model.eval()\n",
        "\n",
        "    ae_models[dataset_name] = ae_model\n",
        "\n",
        "\n",
        "\n",
        "for dataset_name, ae_model in ae_models.items():\n",
        "  print(\"=========================================\")\n",
        "  print(f\"Model for dataset: {dataset_name}\")\n",
        "\n",
        "  df_ae_copy = ics_datasets[dataset_name].copy()\n",
        "  preprocess_ae(df_ae_copy)\n",
        "\n",
        "  # evaluate model\n",
        "  eval_ae(df_ae_copy, ae_model, dataset_name)\n",
        "  df_ae_copy = None\n",
        "\n",
        "  # run model on all other datasets\n",
        "  #for other_dataset_name, _ in ics_datasets.items():\n",
        "  #  if other_dataset_name != dataset_name:\n",
        "  #    print(f\"Model trained on {dataset_name} inferencing {other_dataset_name}\")\n",
        "  #    df_ae_copy = ics_datasets[other_dataset_name].copy()\n",
        "  #    preprocess_ae(df_ae_copy)\n",
