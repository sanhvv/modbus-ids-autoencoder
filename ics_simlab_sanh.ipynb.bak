        "#@title Load Models\n",
        "import requests\n",
        "\n",
        "weight_files = [\n",
        "    \"intelligent_electronic_device_ae_model.pt\",\n",
        "    \"smart_grid_ae_model.pt\",\n",
        "    \"water_bottle_factory_ae_model.pt\",\n",
        "\n",
        "    \"intelligent_electronic_device_dt_model.pkl\",\n",
        "    \"intelligent_electronic_device_knn_model.pkl\",\n",
        "    \"intelligent_electronic_device_rf_model.pkl\",\n",
        "    \"intelligent_electronic_device_svm_model.pkl\",\n",
        "\n",
        "    \"smart_grid_dt_model.pkl\",\n",
        "    \"smart_grid_knn_model.pkl\",\n",
        "    \"smart_grid_rf_model.pkl\",\n",
        "    \"smart_grid_svm_model.pkl\",\n",
        "\n",
        "    \"water_bottle_factory_dt_model.pkl\",\n",
        "    \"water_bottle_factory_knn_model.pkl\",\n",
        "    \"water_bottle_factory_rf_model.pkl\",\n",
        "    \"water_bottle_factory_svm_model.pkl\",\n",
        "]\n",
        "\n",
        "\n",
        "for weight_file in weight_files:\n",
        "  url = f\"https://github.com/JaxsonBrownie/ICS-SimLab-IDS/raw/refs/heads/main/curtin-ics-simlab-ids/data/weights/v4/{weight_file}\"\n",
        "\n",
        "  response = requests.get(url)\n",
        "  with open(weight_file, \"wb\") as f:\n",
        "      f.write(response.content)"
      ]
    },
    {
