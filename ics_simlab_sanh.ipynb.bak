      "cell_type": "markdown",
      "metadata": {
        "id": "KdXpOY3-qBH7"
      },
      "source": [
        "## Support Vector Machine\n",
        "Next we create a function to build and tune Support Vector Machines. We set the kernel function to RBF, whilst using Random Search for hyperparameter tuning. We also reduce the number of search iterations to 5 to improve computing time, which takes significantly longer for SVMs compared to DTs."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "cellView": "form",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "fzsvzzwvqC8B",
        "outputId": "06d08bf3-04d8-4b17-fd90-efe549e803d3"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "=========================================\n",
            "Dataset: Intelligent Electronic Device\n"
          ]
        },
        {
          "output_type": "stream",
          "name": "stderr",
          "text": [
            "/usr/local/lib/python3.12/dist-packages/sklearn/svm/_base.py:305: ConvergenceWarning: Solver terminated early (max_iter=10000).  Consider pre-processing your data with StandardScaler or MinMaxScaler.\n",
            "  warnings.warn(\n",
            "/usr/local/lib/python3.12/dist-packages/sklearn/svm/_base.py:305: ConvergenceWarning: Solver terminated early (max_iter=10000).  Consider pre-processing your data with StandardScaler or MinMaxScaler.\n",
            "  warnings.warn(\n"
          ]
        }
      ],
      "source": [
        "#@title SVM\n",
        "from sklearn.svm import SVC\n",
        "from sklearn.model_selection import KFold, RandomizedSearchCV\n",
        "from sklearn.metrics import accuracy_score, classification_report\n",
        "from sklearn.metrics import classification_report\n",
        "import joblib\n",
        "\n",
        "\n",
        "# FUNCTION: construct_svm\n",
        "# PURPOSE:  Constructs a support vector machine, to be used for the ICS-SimLab\n",
        "#           cleaned datasets\n",
        "def construct_svm(X_train, y_train):\n",
        "  # reduce training time (only for SVM)\n",
        "  X_small, _, y_small, _ = train_test_split(\n",
        "    X_train, y_train, train_size=0.05, stratify=y_train, random_state=42\n",
        "  )\n",
        "\n",
        "  # define hyperparameters to tune\n",
        "  param_dist = {\n",
        "      \"C\": [0.1, 1, 5, 10, 20],\n",
        "      \"kernel\": [\"rbf\"],\n",
        "      \"gamma\": [1, 0.1, 0.01, 0.001, 0.0001]\n",
        "  }\n",
        "\n",
        "  # define k-fold cross-validation\n",
        "  kf = KFold(n_splits=5, shuffle=True, random_state=42)\n",
        "\n",
        "  # create decision tree model\n",
        "  svm_model = SVC(max_iter=10000, random_state=42)\n",
        "\n",
        "  # set up randomized search\n",
        "  random_search = RandomizedSearchCV(\n",
        "      estimator=svm_model,\n",
        "      param_distributions=param_dist,\n",
        "      n_iter=5, # adjust on computing time\n",
        "      cv=kf,\n",
        "      scoring='accuracy',\n",
        "      random_state=42\n",
        "  )\n",
        "\n",
        "  # tune hyperparameters\n",
        "  random_search.fit(X_train, y_train)\n",
        "  print(\"Best parameters found:\", random_search.best_params_)\n",
        "  print(\"Best cross-validation accuracy:\", random_search.best_score_)\n",
        "\n",
        "  # get best model\n",
        "  best_svm_model = random_search.best_estimator_\n",
        "  return best_svm_model\n",
        "\n",
        "\n",
        "# construct model for each dataset\n",
        "for dataset_name, (X_train, X_test, y_train, y_test) in split_ics_datasets.items():\n",
        "  print(\"=========================================\")\n",
        "  print(f\"Dataset: {dataset_name}\")\n",
        "  svm_model = construct_svm(X_train, y_train)\n",
        "\n",
        "  # save the model\n",
        "  file_model_name = dataset_name.lower().replace(\" \", \"_\") + \"_svm_model.pkl\"\n",
        "  joblib.dump(svm_model, file_model_name)\n",
        "\n",
        "  # run predictions and report\n",
        "  y_pred = svm_model.predict(X_test)\n",
        "  print(classification_report(y_test, y_pred, zero_division=0))\n",
        "\n",
        "  # run model on all other datasets\n",
        "  for other_dataset_name, (other_X_train, other_X_test, other_y_train, other_y_test) in split_ics_datasets.items():\n",
        "    if other_dataset_name != dataset_name:\n",
        "      print(f\"Model trained on {dataset_name} inferencing {other_dataset_name}\")\n",
        "      other_y_pred = svm_model.predict(other_X_test)\n",
        "      print(classification_report(other_y_test, other_y_pred, zero_division=0))\n",
        "  print(\"=========================================\")"
      ]
    },
