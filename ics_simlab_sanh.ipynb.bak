        "'''\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "from datetime import datetime, timedelta\n",
        "import numpy as np\n",
        "\n",
        "# ------------------------\n",
        "# Example data\n",
        "# ------------------------\n",
        "# Create time points every second\n",
        "time_points = pd.date_range(start='2025-10-21 12:00:00', periods=10, freq='S')\n",
        "\n",
        "# Dataset 1: random 0/1 values\n",
        "y1 = np.random.randint(0, 2, size=len(time_points))\n",
        "\n",
        "# Dataset 2: random 0/1 values\n",
        "y2 = np.random.randint(0, 2, size=len(time_points))\n",
        "\n",
        "# ------------------------\n",
        "# Plot stacked bar graph\n",
        "# ------------------------\n",
        "plt.figure(figsize=(12,4))\n",
        "\n",
        "# Bottom of y2 bars is y1, so they stack\n",
        "plt.bar(time_points, y1, width=0.000002, color='green', label='Dataset 1')\n",
        "plt.bar(time_points, y2, width=0.000002, bottom=y1, color='red', label='Dataset 2')\n",
        "\n",
        "# Customize axes\n",
        "plt.yticks([0,1,2], ['0','1','2'])  # max value can be 2 when both stack\n",
        "plt.xlabel(\"Time\")\n",
        "plt.ylabel(\"Value\")\n",
        "plt.title(\"Stacked Bar Graph Example\")\n",
        "plt.legend()\n",
        "plt.grid(True, axis='y')\n",
        "plt.show()\n",
        "'''"
