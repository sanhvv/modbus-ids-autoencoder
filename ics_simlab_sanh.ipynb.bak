        "#@title View Dataset Statistics\n",
        "def print_stats(df):\n",
        "  for i in range(1, 10):\n",
        "    print(f\"Attack Category {i} Shape:  {df[df['attack_specific'] == i].shape}\")\n",
        "\n",
        "for dataset_name, df in ics_datasets.items():\n",
        "  print(\"===================================\")\n",
        "  print(f\"Dataset: {dataset_name}\")\n",
        "  print_stats(df)\n",
        "  print(df.head(10))\n",
        "  print(\"===================================\")"
