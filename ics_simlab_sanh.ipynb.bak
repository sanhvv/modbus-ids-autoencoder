    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "\n",
        "# Ensure both DataFrames have datetime x-axis\n",
        "df_window['datetime'] = pd.to_datetime(df_window['datetime'])\n",
        "df_15s['time'] = pd.to_datetime(df_15s['time'])\n",
        "\n",
        "# Merge both datasets on datetime to align bars\n",
        "# If times don’t exactly match, you can resample or round times to the same resolution\n",
        "df_merged = pd.merge(df_window[['datetime','attack_binary']],\n",
        "                     df_15s[['time','attack_binary']],\n",
        "                     left_on='datetime', right_on='time', how='outer', suffixes=('_window','_15s')).fillna(0)\n",
        "\n",
        "# Create bar graph\n",
        "plt.figure(figsize=(12,4))\n",
        "\n",
        "# Plot df_window bars at bottom\n",
        "plt.bar(df_merged['datetime'], df_merged['attack_binary_window'], width=0.000017, color='blue', label='True Anomalies')\n",
        "\n",
        "# Plot df_15s bars stacked on top of df_window bars\n",
        "plt.bar(df_merged['datetime'], df_merged['attack_binary_15s'], width=0.000017,\n",
        "        bottom=df_merged['attack_binary_window'], color='lightblue', label='Detected Anomalies')\n",
        "\n",
        "plt.yticks([0,1,2], ['Normal','Anomaly','Detected Anomaly'])\n",
        "plt.xlabel(\"Time\")\n",
        "plt.ylabel(\"Packet\")\n",
        "plt.title(\"Representation of Detected True Anomalies for a Naive Sensor Read Attack\")\n",
        "plt.legend()\n",
        "plt.grid(True, axis='y')\n",
        "plt.show()\n"
      ],
