      },
      "source": [
        "# Data Processing\n",
        "Here we clean and split the data."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 22,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "ytyVmU6LM9-Q",
        "outputId": "e67577f2-b219-436c-b9eb-f0e6a882d531"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "===================================\n",
            "Dataset: Intelligent Electronic Device\n",
            "Shape: (262589, 19)\n",
            "Column Names: Index(['ip_len', 'ip_frag_offset', 'ip_id', 'ip_ttl', 'ip_proto',\n",
            "       'tcp_window_size', 'tcp_ack', 'tcp_seq', 'tcp_len',\n",
            "       'tcp_urgent_pointer', 'tcp_flags', 'tcp_analysis_ack_rtt',\n",
            "       'tcp_analysis_push_bytes_sent', 'tcp_analysis_bytes_in_flight',\n",
            "       'frame_time_delta', 'attack_specific', 'modbus_func_code',\n",
            "       'ip_flags_df', 'ip_flags_mf'],\n",
            "      dtype='object')\n",
            "===================================\n",
            "Dataset: Smart Grid\n",
            "Shape: (58847, 19)\n",
            "Column Names: Index(['ip_len', 'ip_frag_offset', 'ip_id', 'ip_ttl', 'ip_proto',\n",
            "       'tcp_window_size', 'tcp_ack', 'tcp_seq', 'tcp_len',\n",
            "       'tcp_urgent_pointer', 'tcp_flags', 'tcp_analysis_ack_rtt',\n",
            "       'tcp_analysis_push_bytes_sent', 'tcp_analysis_bytes_in_flight',\n",
            "       'frame_time_delta', 'attack_specific', 'modbus_func_code',\n",
            "       'ip_flags_df', 'ip_flags_mf'],\n",
            "      dtype='object')\n",
            "===================================\n",
            "Dataset: Water Bottle Factory\n",
            "Shape: (186482, 19)\n",
            "Column Names: Index(['ip_len', 'ip_frag_offset', 'ip_id', 'ip_ttl', 'ip_proto',\n",
            "       'tcp_window_size', 'tcp_ack', 'tcp_seq', 'tcp_len',\n",
            "       'tcp_urgent_pointer', 'tcp_flags', 'tcp_analysis_ack_rtt',\n",
            "       'tcp_analysis_push_bytes_sent', 'tcp_analysis_bytes_in_flight',\n",
            "       'frame_time_delta', 'attack_specific', 'modbus_func_code',\n",
            "       'ip_flags_df', 'ip_flags_mf'],\n",
            "      dtype='object')\n"
          ]
        }
      ],
      "source": [
        "#@title Cleaning\n",
        "import ipaddress\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "import pandas as pd # Ensure pandas is imported for data loading\n",
        "from google.colab import drive # Required for pd.read_csv to access mounted drive\n",
        "\n",
        "# Initialize the isClean flag to avoid NameError\n",
        "isClean = False\n",
        "\n",
        "# Check if ics_datasets_orig is defined (e.g., after kernel restart or out-of-order execution)\n",
        "if 'ics_datasets_orig' not in locals():\n",
        "  print(\"ics_datasets_orig not found. Attempting to load datasets...\")\n",
        "  # Note: This assumes drive.mount('/content/drive') has been executed in an earlier cell.\n",
        "  # Re-load datasets from Google Drive paths defined in the 'Load Datasets' cell (e20dce41).\n",
        "  try:\n",
        "    df_ied = pd.read_csv('/content/drive/MyDrive/Colab Notebooks/ics-simlab-modbus/dataset_ied_packetv4.csv')\n",
        "    df_sg = pd.read_csv('/content/drive/MyDrive/Colab Notebooks/ics-simlab-modbus/dataset_sg_packetv4.csv')\n",
        "    df_wbf = pd.read_csv('/content/drive/MyDrive/Colab Notebooks/ics-simlab-modbus/dataset_wbf_packetv4.csv')\n",
        "\n",
        "    # Place each dataframe into a dataset dictionary\n",
        "    ics_datasets_orig = {\n",
        "        \"Intelligent Electronic Device\": df_ied,\n",
        "        \"Smart Grid\": df_sg,\n",
        "        \"Water Bottle Factory\": df_wbf\n",
        "    }\n",
        "    print(\"Datasets loaded successfully within Cleaning cell.\")\n",
        "  except Exception as e:\n",
        "    print(f\"Error loading datasets: {e}. Please ensure Google Drive is mounted and files exist.\")\n",
        "    # If loading fails, re-raise or handle appropriately to prevent subsequent errors\n",
        "    raise\n",
        "\n",
        "#########################################################################\n",
        "# FUNCTION: clean_dataset\n",
        "# PURPOSE:  Performs dataset cleaning\n",
        "# NOTE:\n",
        "#   may need to encode MAC / IP\n",
        "#   may need to drop other columns\n",
        "def clean_dataset(df, multiclass=True):\n",
        "  df_c = df.copy()\n",
        "\n",
        "  # drop all protocols apart from MODBUS\n",
        "  if \"protocol\" in df_c.columns:\n",
        "    df_c = df_c[df_c['protocol'] == 'MODBUS']\n",
        "  df_c = df_c.drop(\"protocol\", axis=1)\n",
        "\n",
        "  # drop the time column\n",
        "  df_c = df_c.drop(\"time\", axis=1)\n",
        "\n",
        "  # set NaN rows in \"tcp_analysis_ack_rtt\" to the mean\n",
        "  mean_rtt = df_c[\"tcp_analysis_ack_rtt\"].mean()\n",
        "  df_c[\"tcp_analysis_ack_rtt\"] = df_c[\"tcp_analysis_ack_rtt\"].fillna(mean_rtt)\n",
        "\n",
        "  # convert all \"N/A\" fields to 0 (affect only the attack categoty columns)\n",
        "  df_c = df_c.fillna(0)\n",
        "  df_c = df_c.replace(\"N/A\", 0)\n",
        "\n",
        "  # convert ip address to int\n",
        "  #df_c['ip_src'] = df_c['ip_src'].apply(lambda x: int(ipaddress.IPv4Address(x)))\n",
        "  #df_c['ip_dst'] = df_c['ip_dst'].apply(lambda x: int(ipaddress.IPv4Address(x)))\n",
        "\n",
        "  # convert mac address to int\n",
        "  #df_c['ether_src_mac'] = df_c['ether_src_mac'].apply(lambda x: int(x.replace(\":\", \"\"), 16))\n",
        "  #df_c['ether_dst_mac'] = df_c['ether_dst_mac'].apply(lambda x: int(x.replace(\":\", \"\"), 16))\n",
        "\n",
        "  # limit the modbus_data to 16 hex digits\n",
        "  df_c['modbus_data'] = df_c['modbus_data'].astype(str).apply(lambda x: x[:12])\n",
        "\n",
        "  # convert all hex to int\n",
        "  df_c['ip_id'] = df_c['ip_id'].apply(lambda x: int(str(x), 16))\n",
        "  df_c['ip_checksum'] = df_c['ip_checksum'].apply(lambda x: int(str(x), 16))\n",
        "  df_c['tcp_flags'] = df_c['tcp_flags'].apply(lambda x: int(str(x), 16))\n",
        "  df_c['modbus_data'] = df_c['modbus_data'].apply(\n",
        "      lambda x: int(str(x).replace(\"0x\", \"\"), 16) if str(x).replace(\"0x\", \"\") else None\n",
        "  )\n",
        "\n",
        "  # drop mac and ip (may encode later)\n",
        "  df_c = df_c.drop(\"ip_src\", axis=1)\n",
        "  df_c = df_c.drop(\"ip_dst\", axis=1)\n",
        "  df_c = df_c.drop(\"ether_src_mac\", axis=1)\n",
        "  df_c = df_c.drop(\"ether_dst_mac\", axis=1)\n",
        "\n",
        "  # drop clearly redundant columns\n",
        "  df_c = df_c.drop(\"ip_checksum\", axis=1)\n",
        "  df_c = df_c.drop(\"modbus_data\", axis=1)   # WILL PROBABLY CHANGE\n",
        "\n",
        "  # standardize selected columns (may change)\n",
        "  std_scaler = StandardScaler()\n",
        "  dontStand = [\"attack_binary\", \"attack_obj\", \"attack_specific\",\n",
        "               \"modbus_func_code\",\n",
        "               \"ip_flags_df\", \"ip_flags_mf\",]\n",
        "               #\"protocol\"]\n",
        "\n",
        "  standardized = df_c.drop(columns=dontStand)\n",
        "  ignore = df_c[dontStand]\n",
        "  features_scaled = pd.DataFrame(\n",
        "      std_scaler.fit_transform(standardized),\n",
        "      columns=standardized.columns,\n",
        "      index=standardized.index)\n",
        "  df_c = pd.concat([features_scaled, ignore], axis=1)\n",
        "\n",
        "  if \"protocol\" in df_c.columns:\n",
        "    # keep only valid protocols\n",
        "    valid_protocols = [\"TCP\", \"UDP\", \"ICMP\", \"ARP\", \"DNS\", \"HTTP\", \"HTTPS\", \"FTP\", \"SSH\"]\n",
        "    df_c = df_c[df_c[\"protocol\"].isin(valid_protocols)]\n",
        "\n",
        "    # one-shot encode protocol\n",
        "    df_c = pd.get_dummies(df_c, columns=['protocol'])\n",
        "\n",
        "  # convert classifcation columns to integers\n",
        "  df_c['attack_binary'] = df_c['attack_binary'].astype(int)\n",
        "  df_c['attack_obj'] = df_c['attack_obj'].astype(int)\n",
        "  df_c['attack_specific'] = df_c['attack_specific'].astype(int)\n",
        "\n",
        "  # drop any features that cause label leaking\n",
        "  df_c = df_c.drop(\"tcp_stream\", axis=1)\n",
        "  df_c = df_c.drop(\"frame_time_relative\", axis=1)\n",
        "\n",
        "  # drop attack info (may change) due to label leaking\n",
        "  if multiclass:\n",
        "    df_c = df_c.drop(\"attack_binary\", axis=1)\n",
        "    df_c = df_c.drop(\"attack_obj\", axis=1)\n",
        "  else:\n",
        "    df_c = df_c.drop(\"attack_specific\", axis=1)\n",
        "    df_c = df_c.drop(\"attack_obj\", axis=1)\n",
        "\n",
        "  # reduce DDOS instances to avoid anomaly class overfill\n",
        "  df_attack8 = df_c[df_c[\"attack_specific\"] == 8]\n",
        "  df_others = df_c[df_c[\"attack_specific\"] != 8]\n",
        "  df_attack8_reduced = df_attack8.sample(frac=0.10, random_state=42)  # keep 10%, adjust as needed\n",
        "  df_c = pd.concat([df_others, df_attack8_reduced])\n",
        "\n",
        "  #df_c = df_c[df_c['attack_specific'] != 8] # data flood\n",
        "  #df_c = df_c[df_c['attack_specific'] != 9] # connection flood\n",
        "\n",
        "  # drop other stuff\n",
        "  #df_c = df_c.drop(\"frame_time_relative\", axis=1)\n",
        "  #df_c = df_c.drop(\"modbus_data\", axis=1)\n",
        "  #df_c = df_c.drop(\"modbus_func_code\", axis=1)\n",
        "  #df_c = df_c.dropna()\n",
        "\n",
        "  return df_c\n",
        "#########################################################################\n",
        "\n",
        "# clean all datasets\n",
        "if isClean == False:\n",
        "  ics_datasets = {}\n",
        "  for dataset_name, df in ics_datasets_orig.items():\n",
        "    ics_datasets[dataset_name] = clean_dataset(df)\n",
        "  isClean = True\n",
        "\n",
        "# print processed dataset\n",
        "for dataset_name, df in ics_datasets.items():\n",
        "  print(\"===================================\")\n",
        "  print(f\"Dataset: {dataset_name}\")\n",
        "  print(f\"Shape: {df.shape}\")\n",
        "  print(f\"Column Names: {df.columns}\")"
      ]
    },
    {
