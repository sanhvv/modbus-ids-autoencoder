      "source": [
        "#@title KNN\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.neighbors import KNeighborsClassifier\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score\n",
        "from scipy.stats import randint\n",
        "import joblib\n",
        "\n",
        "# FUNCTION: construct_knn\n",
        "# PURPOSE:  Builds a K-Nearest Neighbour model. Uses a pipeline to standardize\n",
        "#           the dataset, which is cruical for KNN models.\n",
        "def construct_knn(X_train, y_train):\n",
        "\n",
        "  # define hyperparameters\n",
        "  param_dist = {\n",
        "      'knn__n_neighbors': randint(1, 21),\n",
        "      'knn__weights': ['uniform', 'distance'],\n",
        "      'knn__metric': ['euclidean', 'manhattan']\n",
        "  }\n",
        "\n",
        "  # define k-fold cross-validation\n",
        "  kf = KFold(n_splits=5, shuffle=True, random_state=42)\n",
        "\n",
        "  # construct model\n",
        "  knn_model = KNeighborsClassifier()\n",
        "\n",
        "  # use a pipeline for KNN to ensure proper standardization\n",
        "  pipeline = Pipeline([\n",
        "      ('scaler', StandardScaler()),\n",
        "      ('knn', knn_model)\n",
        "  ])\n",
        "\n",
        "  # set up random search\n",
        "  random_search = RandomizedSearchCV(\n",
        "      estimator=pipeline,\n",
        "      param_distributions=param_dist,\n",
        "      n_iter=5,\n",
        "      cv=kf,\n",
        "      scoring='accuracy',\n",
        "      random_state=42\n",
        "  )\n",
        "\n",
        "  # tune hyperparameters\n",
        "  random_search.fit(X_train, y_train)\n",
        "  print(\"Best parameters found:\", random_search.best_params_)\n",
        "  print(\"Best cross-validation accuracy:\", random_search.best_score_)\n",
        "\n",
        "  # get best model\n",
        "  best_knn_model = random_search.best_estimator_\n",
        "  return best_knn_model\n",
        "\n",
        "\n",
        "# construct model for each dataset\n",
        "for dataset_name, (X_train, X_test, y_train, y_test) in split_ics_datasets.items():\n",
        "  print(\"=========================================\")\n",
        "  print(f\"Dataset: {dataset_name}\")\n",
        "  knn_model = construct_knn(X_train, y_train)\n",
        "\n",
        "  # save the model\n",
        "  file_model_name = dataset_name.lower().replace(\" \", \"_\") + \"_knn_model.pkl\"\n",
        "  joblib.dump(knn_model, file_model_name)\n",
        "\n",
        "  # run predictions and report\n",
        "  y_pred = knn_model.predict(X_test)\n",
        "  print(classification_report(y_test, y_pred, zero_division=0))\n",
        "\n",
        "  # run model on all other datasets\n",
        "  for other_dataset_name, (other_X_train, other_X_test, other_y_train, other_y_test) in split_ics_datasets.items():\n",
        "    if other_dataset_name != dataset_name:\n",
        "      print(f\"Model trained on {dataset_name} inferencing {other_dataset_name}\")\n",
        "      other_y_pred = knn_model.predict(other_X_test)\n",
        "      print(classification_report(other_y_test, other_y_pred, zero_division=0))\n",
        "  print(\"=========================================\")"
      ]
    },
